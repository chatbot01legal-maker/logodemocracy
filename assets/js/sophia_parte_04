              <div style="font-size: 0.6rem; color: rgba(229,231,235,.2); margin-top: 12px;">
                * Evaluación determinista con métricas de saturación.
              </div>
            </div>
          </div>
        `;
        this._animateBars(out);
      }, 600);
    });
  },


  // ─── INICIALIZACIÓN DEFINITIVA ──
  init() {
